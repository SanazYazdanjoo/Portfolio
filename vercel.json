{
  "cleanUrls": true,
  "functions": {
    "api/chat.js": { "maxDuration": 30 }
  },
  "redirects": [
    { "source": "/projects/project-1", "destination": "/projects/gaze-assisted-input", "permanent": true },
    { "source": "/projects/project-2", "destination": "/projects/deskbird-hybrid-work", "permanent": true },
    { "source": "/projects/project-3", "destination": "/projects/embraceme-soft-robotics", "permanent": true },
    { "source": "/projects/project-4", "destination": "/projects/digitalising-ibs-travel-reimbursements", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}