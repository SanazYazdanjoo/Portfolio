# Copy to .env for local development (server/server.js reads it; .env is
# gitignored). In production, set the same variables in Vercel:
# Project Settings → Environment Variables.

# Required for the "Ask this portfolio" chat (api/chat.js). Use a dedicated
# OpenAI project key with a monthly budget cap — that cap, not the in-code
# rate limiting, is the hard cost ceiling.
OPENAI_API_KEY=sk-...

# Optional. Defaults to gpt-5-mini.
# OPENAI_MODEL=gpt-5-mini
